<Project>
  <!-- A global using for the xUnit v2 adapter's namespace, in projects with implicit usings enabled.
       Set AhrAssuranceImplicitUsings to false to leave it out. -->
  <ItemGroup Condition="('$(ImplicitUsings)' == 'enable' Or '$(ImplicitUsings)' == 'true') And '$(AhrAssuranceImplicitUsings)' != 'false'">
    <Using Include="Ahr.Assurance.Xunit" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)Ahr.Assurance.TestingPlatform.targets" Condition="Exists('$(MSBuildThisFileDirectory)Ahr.Assurance.TestingPlatform.targets')" />
</Project>
