<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>NUnit adapter for Ahr.Assurance: named Given/When/Then steps over ordinary NUnit tests, with evidence linked to business outcomes, rules and risks.</Description>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ahr.Assurance.NUnit.Tests" />
    <InternalsVisibleTo Include="Ahr.Assurance.NUnit3.Tests" />
    <InternalsVisibleTo Include="Ahr.Assurance.NUnit5.Tests" />
    <ProjectReference Include="../../../Ahr.Assurance/Ahr.Assurance.csproj" />
    <!-- The oldest NUnit supported; one build serves NUnit 3.14 and 4. -->
    <PackageReference Include="NUnit" VersionOverride="3.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/Ahr.Assurance.NUnit.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- The Microsoft.Testing.Platform extension, built for each platform major version. -->
    <ProjectReference Include="../../../Ahr.Assurance.TestingPlatform/v1/Ahr.Assurance.TestingPlatform.v1.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../../Ahr.Assurance.TestingPlatform/v2/Ahr.Assurance.TestingPlatform.v2.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../../Ahr.Assurance.TestingPlatform/Ahr.Assurance.TestingPlatform.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="../../../Ahr.Assurance.TestingPlatform/bin/$(Configuration)/v1/Ahr.Assurance.TestingPlatform.dll" Pack="true" PackagePath="buildTransitive/platform/v1/" Visible="false" />
    <None Include="../../../Ahr.Assurance.TestingPlatform/bin/$(Configuration)/v2/Ahr.Assurance.TestingPlatform.dll" Pack="true" PackagePath="buildTransitive/platform/v2/" Visible="false" />
  </ItemGroup>
</Project>
